# Server Configuration
PORT=3001

# LLM Providers (Provide at least one, or leave blank to use the built-in Mock Simulator)
# Option 1: Google Gemini (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=

# Option 2: Groq (Ultra-fast, generous free tier at https://console.groq.com/)
GROQ_API_KEY=

# Option 3: OpenAI (GPT-4o-mini / GPT-3.5-turbo)
OPENAI_API_KEY=

# Active Provider: "gemini" | "groq" | "openai" | "mock"
# If left empty, will automatically detect whichever API key is set, or fall back to high-fidelity mock
LLM_PROVIDER=
